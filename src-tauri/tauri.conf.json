{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LineMemo Lite",
  "version": "0.1.0",
  "identifier": "local.linememo.lite",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LineMemo Lite",
        "width": 720,
        "height": 560,
        "minWidth": 480,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"]
  }
}
